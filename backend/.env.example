POSTGRES_USER=ai_assistant
POSTGRES_PASSWORD=ai_customer_assistant_password
POSTGRES_DB=ai_customer_assistant
POSTGRES_HOST=postgres
POSTGRES_PORT=5432

MINIO_ENDPOINT=localhost:9000
MINIO_ROOT_USER=minioadmin
MINIO_ROOT_PASSWORD=minioadmin123
MINIO_BUCKET=knowledge-documents
MINIO_SECURE=false

TIKA_BASE_URL=http://localhost:9998

APP_ENV=development
APP_PORT=8000

# Provider keys can also be set from the Admin > API Keys page, where they
# are encrypted at rest. A key saved there SHADOWS the variable below; this
# stays the fallback, so leaving it set is the safe thing to do.
GROQ_API_KEY=your_groq_api_key_here

EAV_MODEL=openai/gpt-oss-120b
EAV_EXTRACTION_REQUIRED=false

INGESTION_CHUNK_SIZE_TOKENS=500
INGESTION_CHUNK_OVERLAP_TOKENS=75
INGESTION_EMBEDDING_MODEL_NAME=BAAI/bge-base-en-v1.5
INGESTION_EMBEDDING_DIMENSION=768
INGESTION_NORMALIZE_EMBEDDINGS=true

# --- Authentication (P0-3) ---

# Signs every JWT. REQUIRED: the process refuses to start without it, on
# purpose -- a defaulted signing key means anyone who has read the source can
# mint valid tokens for any account. Generate one with:
#   python -c "import secrets; print(secrets.token_urlsafe(48))"
# At least 32 characters. Changing it signs everyone out.
AUTH_SECRET=

# Send session cookies only over HTTPS. Leave true. Browsers treat
# http://localhost as trustworthy, so local development works with it on;
# set it to false ONLY to reach the app over plain HTTP at a LAN address,
# and understand that this sends session tokens in clear text.
AUTH_COOKIE_SECURE=true

# Strict is right while the frontend is served from the API's own origin,
# which is what makes CSRF a non-problem here. Loosen only for a genuinely
# cross-site frontend.
AUTH_COOKIE_SAMESITE=strict

# Comma-separated origins allowed to call this API cross-origin. Empty is
# correct for the default deployment: the frontend is served same-origin, so
# no CORS is involved at all. A wildcard is not accepted -- the session is a
# cookie, and the CORS spec forbids combining credentials with "*".
CORS_ALLOW_ORIGINS=

# Trust X-Forwarded-For for rate-limit keys. Only enable behind a proxy that
# sets it: anyone can send the header, so trusting it without a proxy lets a
# caller choose their own rate-limit key, which is to say opt out entirely.
TRUST_PROXY_HEADERS=false

# Turn off rate limiting. For tests and single-user local development only.
RATE_LIMIT_DISABLED=false

# --- Crawler safety (SSRF guard) ---

# Restrict crawling to these domains (comma-separated, subdomains included).
# Empty means any publicly-routable host, which is right for a crawler whose
# job is to read the open web.
CRAWL_DOMAIN_ALLOWLIST=

# Networks exempted from the private/loopback/link-local refusal, as CIDRs.
# Empty is correct unless you genuinely crawl an intranet site. This is a
# list rather than a switch so that opening 10.1.0.0/16 does not also open
# 169.254.169.254 -- adding that range hands an authenticated caller the
# cloud instance's credentials.
CRAWL_ALLOW_ADDRESSES=

# --- Ingestion worker -------------------------------------------------------
# How many documents the worker processes at once. Lanes inside one process,
# sharing one embedding model. Extraction is bound by the provider's token
# budget rather than by this worker, so more lanes mostly mean more 429s;
# set to 1 for strictly serial processing.
PGQUEUE_CONCURRENCY=2
# How many times a transient failure (rate limit, Tika restart, a worker that
# died) is retried before the job is dead-lettered.
INGEST_JOB_MAX_ATTEMPTS=4
# First retry delay in seconds, doubling to INGEST_JOB_BACKOFF_MAX_S.
INGEST_JOB_BACKOFF_BASE_S=600
INGEST_JOB_BACKOFF_MAX_S=3600

# --- Public chat spend ceiling ---------------------------------------------
# Chat is public: no account, no signup. One turn costs roughly 6,900 model
# tokens, so this counts EVERY turn into one bucket regardless of who asked.
# It is a spend ceiling, not an abuse limit -- the per-caller limits bound an
# ordinary user, and a determined one rotates IP addresses past them. Raise it
# the moment the deployment stops being on a free tier.
CHAT_GLOBAL_PER_DAY=400
